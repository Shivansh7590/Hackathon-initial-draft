# Local dev (optional copy to client/.env)
VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000

# Or use a single origin (recommended for Netlify — one variable):
# VITE_BACKEND_URL=http://localhost:4000

# Production (Netlify): set VITE_BACKEND_URL only — must be public HTTPS, not localhost.
# VITE_BACKEND_URL=https://your-api.onrender.com
