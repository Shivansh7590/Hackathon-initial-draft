# Copy this file to .env in this folder: TAKEN/server/.env
#
# CORS + Socket.IO: browser origins allowed (comma-separated). Include your Netlify URL:
# CLIENT_URL=https://your-site.netlify.app,http://localhost:5173
#
# Get a DeepSeek key (you must use your own account): https://platform.deepseek.com/

# --- DeepSeek (direct) — used first for AI Chat if set ---
DEEPSEEK_API_KEY=
# Optional:
# DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
# DEEPSEEK_CHAT_MODEL=deepseek-chat
# For reasoning model (if your account supports it): deepseek-reasoner

# Option B — OpenRouter (uses deepseek/deepseek-chat by default; works if you already use OpenRouter elsewhere)
OPENROUTER_API_KEY=
# Optional:
# OPENROUTER_CHAT_MODEL=deepseek/deepseek-chat
# OPENROUTER_HTTP_REFERER=http://localhost:5173
